MONGODB_URI=mongodb://localhost:27017/avaporu
PORT=4000
JWT_SECRET=cambiame
JWT_EXPIRES=2d

# --- Envío de reportes automáticos por email ---
# Con Gmail: usar una "contraseña de aplicación" (no la contraseña normal de la cuenta),
# generada en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM=AVAPORU <tu-cuenta@gmail.com>
